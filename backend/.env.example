# MySQL из infra/docker-compose (порт 3306)
DATABASE_URL=mysql+aiomysql://app:app@127.0.0.1:3306/app?charset=utf8mb4

# Локально без Docker:
# DATABASE_URL=sqlite+aiosqlite:///./local.db

OPENAI_API_KEY=sk-replace-me
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe

# Куда складывать загруженные wav для ASR
LOCAL_AUDIO_DIR=./data/audio

# JWT (поставь свой длинный секрет)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email verification SMTP (optional for local dev; code is logged if not configured)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=replace-me
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=AI Analytics Assistant
# SMTP_USE_TLS=true

# Dataset security defaults
# Normal upload endpoints are capped in code at 62.5 MB, document uploads at 25 MB,
# and Big Data uploads at 5 GB. For local Big Data registration, allow only files
# under these server-side roots (separate multiple roots with the OS path separator).
# BIGDATA_ALLOWED_LOCAL_ROOTS=./data/bigdata/raw

# Необязательно: абсолютный или относительно папки backend путь к каталогу с intent-моделью
# (должны лежать config.json, tokenizer*, model.safetensors или pytorch_model.bin)
# По умолчанию: app/models/intent1.0 (веса могут быть во вложенной папке, напр. intent_model_final)
# INTENT_MODEL_DIR=./app/models/intent1.0
# Для обученной Intent 1.0 в label_map.json часто unknown_threshold=0.65 — можно подобрать порог:
# INTENT_CONFIDENCE_THRESHOLD=0.55
